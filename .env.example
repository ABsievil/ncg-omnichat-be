APP_NAME=ncg-omnichat-be
NODE_ENV=development
PORT=8090
API_PREFIX=api
API_VERSION=1
APP_RELEASE=0.0.1
APP_TIMEZONE=UTC+7
APP_CLIENT_APP_KEY=

DATABASE_URL=mongodb://127.0.0.1:27017/ncg-omnichat
DATABASE_DEBUG=false
DATABASE_SERVER_SELECTION_TIMEOUT_MS=5000

MESSAGE_DEFAULT_LANGUAGE=en
MESSAGE_AVAILABLE_LANGUAGES=en,vi

MIDDLEWARE_BODY_JSON_LIMIT=1mb
MIDDLEWARE_BODY_URLENCODED_LIMIT=1mb
MIDDLEWARE_BODY_RAW_LIMIT=1mb
MIDDLEWARE_BODY_TEXT_LIMIT=1mb
MIDDLEWARE_REQUEST_TIMEOUT_SEC=30

CORS_ORIGIN=*
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_HEADERS=Content-Type,Authorization,Accept-Language,x-lang,x-omnichat-client-id,x-omnichat-session-id

MIDDLEWARE_URL_VERSION_FROM_PATH=true
MIDDLEWARE_RESPONSE_TIME_HEADER=x-response-time

MIDDLEWARE_THROTTLE_TTL_MS=60000
MIDDLEWARE_THROTTLE_LIMIT=100

HELPER_JWT_SECRET_KEY=omnichat-change-me
HELPER_JWT_EXPIRATION=1h
HELPER_JWT_REFRESH_EXPIRATION=30d

# Dev OTP is always 123456 (see OtpService). Swap provider in production.
AUTH_OTP_TTL_SECONDS=300
AUTH_DEV_OTP_CODE=123456

REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=omnichat:

# MinIO (S3-compatible) — local docker-compose
R2_ACCESS_KEY_ID=omnichat
R2_SECRET_ACCESS_KEY=omnichat_secret
R2_ENDPOINT=http://127.0.0.1:9000
R2_BUCKET=omnichat-media
R2_PUBLIC_ENDPOINT=http://127.0.0.1:9000/omnichat-media

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_STORAGE_BUCKET_URL=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_ENDPOINT=

PUBSUB_ENABLED=false
PUBSUB_PROJECT_ID=

ENCRYPTION_AES_ENABLE=false
ENCRYPTION_AES_KEY_CLIENT=
ENCRYPTION_AES_KEY=
ENCRYPTION_AES_IV=

DEBUG_ENABLE=false
