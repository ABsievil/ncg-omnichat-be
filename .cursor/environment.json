{
  "name": "ncg-omnichat-be",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "bash .cursor/scripts/install.sh",
  "start": "bash .cursor/scripts/start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "yarn start:dev",
      "description": "Omnichat NestJS API in watch mode (http://localhost:8090, prefix /api/v1)."
    }
  ],
  "ports": [
    {
      "name": "api",
      "port": 8090
    }
  ]
}
